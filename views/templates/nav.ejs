<header>
    <nav class="navbar">
        <div class="nav-left">
            <a href="/">Hjemmeside</a>
        </div>
        <div class="nav-right">
            <% if (user) { %>
                <a href="/saker">Alle saker</a>
                <a href="/saker/opprett">Opprett sak</a>
                <a href="/logout">Logg ut</a>
            <% } else { %>
                <a href="/signup">Registrer</a>
                <a href="/login">Login</a>
            <% } %>
            <% if (user && user.role === "admin") { %>
                <a href="/admin">Admin</a>
            <% } %>
        </div>
    </nav>
</header>